# ArogyaSaathi Backend Environment Configuration
PROJECT_NAME="ArogyaSaathi Health Gateway"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Cryptography (DPDP Compliance)
# SECRET_KEY for JWT tokens
SECRET_KEY="change-me-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 32-byte Base64-encoded AES key for PII Encryption at rest
PII_ENCRYPTION_KEY="generate-with: python -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""
# Salt for deterministic pseudonymization of Patient IDs
PSEUDONYM_SALT="change-me-random-string"

# Database Configuration (PostgreSQL + PostGIS + TimescaleDB + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=arogya_user
POSTGRES_PASSWORD=arogya_secure_pass_2026
POSTGRES_DB=arogyasaathi_db

# Async and Sync Database URLs
DATABASE_URL="postgresql+asyncpg://arogya_user:arogya_secure_pass_2026@localhost:5432/arogyasaathi_db"
SYNC_DATABASE_URL="postgresql://arogya_user:arogya_secure_pass_2026@localhost:5432/arogyasaathi_db"

# Redis Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Celery Task Queue
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# MinIO / S3 Object Storage (Audio consents, recordings, referral PDFs)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="arogya_minio_admin"
MINIO_SECRET_KEY="arogya_minio_secret_key_2026"
MINIO_BUCKET_AUDIO="arogya-audio-records"
MINIO_BUCKET_DOCS="arogya-referral-docs"
MINIO_SECURE=false

# Allowed CORS origins (Flutter Web / Desktop / PHC Portal)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","*"]

# ===== Portal server (app/local_server.py) =====
# Shared code staff (ASHA / doctor / officer) enter when creating their account. Set a private value.
STAFF_SIGNUP_CODE=""
# Anthropic API key for the patient AI assistant
ANTHROPIC_API_KEY=""
# Ports to listen on (comma separated) and SQLite database location
# PORT="8080"
# AROGYA_DB_PATH="/var/lib/arogya/arogya.db"
